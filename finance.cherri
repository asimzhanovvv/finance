/*
  Финансы: быстрый учёт трат и статистика
  Данные: iCloud Drive / Shortcuts / finance.txt (один файл)

  Входы (текст):
    пусто               меню: категории, статистика, отмена
    PAY:<сумма>|<место> из автоматизации Apple Pay, только выбор категории
    AI:<сводка>         сайт просит совет у модели на iPhone
    APPLY               сайт положил новый файл в буфер обмена
    STATS               сразу открыть статистику
*/

#define name Finance
#define color green
#define glyph walletPass
#define inputs text
#question site "Ссылка на твой сайт статистики (GitHub Pages)" "https://username.github.io/finance/"

#include 'actions/text'
#include 'actions/documents'
#include 'actions/web'
#include 'actions/crypto'
#include 'actions/intelligence'
#include 'actions/sharing'
#include 'actions/calendar'
#include 'actions/images'

// Цветные кружки (индексы 1..12 = палитра сайта) и белые иконки категорий
@dots = list('', '', '', '', '', '', '', '', '', '', '', '')
@glyphs = {"food": "", "groceries": "", "transport": "", "coffee": "", "shopping": "", "fun": "", "phone": "", "health": "", "home": "", "study": "", "gift": "", "travel": "", "sport": "", "beauty": "", "pets": "", "bills": "", "fuel": "", "wallet": "", "music": "", "repeat": "", "other": ""}
const statsTile = ''
const undoTile = ''
const gearTile = ''

@input = "{ShortcutInput}"
@mode = "menu"
@amount = ""
@note = ""

// ---------- файл данных: создать при первом запуске ----------
@file = getFile("finance.txt", nil, false)
@data = "{@file}"
if @data !contains "FIN1" {
    // старый файл в другом формате: сохранить копию и начать заново
    if @data {
        @oldSave = setName(@data, "finance-old.txt")
        saveFile("finance-old.txt", @oldSave, true)
    }
    @init = list("FIN1", "s|cur|₸", "s|budget|0", "c|a|food|Еда|1", "c|b|groceries|Продукты|4", "c|c|transport|Транспорт|6", "c|d|coffee|Кафе и кофе|11", "c|e|shopping|Покупки|10", "c|f|fun|Развлечения|8", "c|g|phone|Связь и подписки|7", "c|h|health|Здоровье|5", "c|i|home|Дом|2", "c|j|study|Учёба|9", "c|z|other|Другое|12")
    const initText = joinText(@init, "\n")
    @initFile = setName(initText, "finance.txt")
    saveFile("finance.txt", @initFile, true)
    @data = "{initText}"
}

// ---------- маршрутизация входа ----------
if @input beginsWith "PAY:" {
    @mode = "pay"
    @payload = replaceText("PAY:", "", @input)
    @payParts = splitText(@payload, "|")
    @amountItem = getFirstItem(@payParts)
    @amount = "{@amountItem}"
    @noteItem = getLastItem(@payParts)
    @note = "{@noteItem}"
    if @payload !contains "|" {
        @note = ""
    }
}
if @input beginsWith "AI:" {
    @mode = "ai"
}
if @input == "APPLY" {
    @mode = "apply"
}
if @input == "STATS" {
    @mode = "stats"
}

@ts = formatDate(CurrentDate, "Custom", "yyMMddHHmm")

// ---------- AI-совет (запрос пришёл с сайта) ----------
if @mode == "ai" {
    @summary = replaceText("AI:", "", @input)
    @answer = askLLM("Ты внимательный финансовый помощник студента. Ниже сводка его расходов. Дай 3-5 коротких конкретных советов на русском языке: где можно сэкономить, что выросло относительно прошлого месяца, на что обратить внимание. Без вступления и без эмодзи, каждый совет одним предложением с новой строки.\n\n{@summary}", "Apple Intelligence on Device")
    @answerText = "{@answer}"
    @clean1 = replaceText("|", "/", @answerText)
    @clean2 = replaceText("\n", " ¶ ", @clean1)
    @aLine = "a|{@ts}|{@clean2}"
    appendToFile("finance.txt", @aLine)
    @mode = "stats"
}

// ---------- сохранить изменения, сделанные на сайте ----------
if @mode == "apply" {
    @clip = getClipboard()
    @clipText = "{@clip}"
    if @clipText beginsWith "FIN1" {
        @oldFile = getFile("finance.txt", nil, false)
        if @oldFile {
            @backup = setName(@oldFile, "finance-backup.txt")
            saveFile("finance-backup.txt", @backup, true)
        }
        @newFile = setName(@clipText, "finance.txt")
        saveFile("finance.txt", @newFile, true)
        showNotification("Изменения с сайта сохранены. Прошлая версия лежит в finance-backup.txt", "Финансы", false)
        @mode = "stats"
    } else {
        alert("В буфере обмена нет данных с сайта. Нажми на сайте «Сохранить на iPhone» ещё раз.", "Финансы")
        stop()
    }
}

// ---------- выбор категории (меню или после Apple Pay) ----------
if @mode == "menu" || @mode == "pay" {
    @catLines = matchText('(?m)^c[|].*$', @data)
    if !@catLines {
        alert("Не нашёл категории в finance.txt (Файлы → iCloud Drive → Shortcuts). Пришли мне, что в нём лежит.", "Финансы")
    }
    const catText = "{@catLines}"
    const catKey = hash(catText)

    // Карточки меню с иконками собираются один раз и кешируются,
    // пересобираются только когда меняются категории
    @keyFile = getFile("finance-menu-key.txt", nil, false)
    @savedKey = "{@keyFile}"
    @menuFile = getFile("finance-menu.txt", nil, false)
    @menuText = "{@menuFile}"
    if @savedKey != catKey || !@menuText {
        @cards = []
        for catLine in @catLines {
            @f = splitText("{@catLine}", "|")
            @cIcon = getListItem(@f, 3)
            @cName = getListItem(@f, 4)
            @cColor = getListItem(@f, 5)
            @cIdx = number(@cColor)
            @dotB64 = getListItem(@dots, @cIdx)
            @glyphB64 = getValue(@glyphs, "{@cIcon}")
            if !@glyphB64 {
                @glyphB64 = getValue(@glyphs, "other")
            }
            @dotImg = base64Decode(@dotB64)
            @glyphImg = base64Decode(@glyphB64)
            @tile = customImageOverlay(@dotImg, @glyphImg, "52", "52")
            @tileB64 = base64Encode(@tile)
            // переносы base64 превращаем в «сложенные» строки vCard
            @tileFolded = replaceText("\n", "\n ", @tileB64)
            @cards += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:{@cName}\nORG;CHARSET=utf-8:\nPHOTO;ENCODING=b;TYPE=PNG:{@tileFolded}\nEND:VCARD"
        }
        @menuText = "{@cards}"
        @menuSave = setName(@menuText, "finance-menu.txt")
        saveFile("finance-menu.txt", @menuSave, true)
        @keySave = setName(catKey, "finance-menu-key.txt")
        saveFile("finance-menu-key.txt", @keySave, true)
    }

    @allCards = @menuText
    @prompt = "На что потратил?"
    if @mode == "pay" {
        @prompt = "{@amount}  {@note}"
    }
    if @mode == "menu" {
        @allCards = "{@menuText}\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Статистика\nORG;CHARSET=utf-8:Графики, дни, советы\nPHOTO;ENCODING=b;TYPE=PNG:{statsTile}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Отменить последнюю\nORG;CHARSET=utf-8:Удалить последнюю запись\nPHOTO;ENCODING=b;TYPE=PNG:{undoTile}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Настройки\nORG;CHARSET=utf-8:Очистить статистику\nPHOTO;ENCODING=b;TYPE=PNG:{gearTile}\nEND:VCARD"
    }

    @vcf = setName(@allCards, "menu.vcf")
    @contacts = @vcf.contact
    @chosen = chooseFromList(@contacts, @prompt)
    @chosenName = "{@chosen}"

    if @chosenName == "Статистика" {
        @mode = "stats"
    }

    if @chosenName == "Отменить последнюю" {
        @txLines = matchText('(?m)^[0-9]{10}[|].*$', @data)
        @lastTx = getLastItem(@txLines)
        @lastText = "{@lastTx}"
        if @lastText {
            @lp = splitText(@lastText, "|")
            @lTs = getListItem(@lp, 1)
            @lAmt = getListItem(@lp, 2)
            @lNote = getListItem(@lp, 4)
            confirm("Удалить {@lAmt} ({@lNote})?", "Отменить последнюю трату")
            @xLine = "x|{@lTs}|{@lAmt}"
            appendToFile("finance.txt", @xLine)
            showNotification("Последняя запись удалена", "Финансы", false)
        } else {
            alert("Записей пока нет", "Финансы")
        }
        stop()
    }

    if @chosenName == "Настройки" {
        menu "Настройки" {
            item "Очистить статистику":
                confirm("Удалятся все траты, итоги дней и AI-советы. Категории, валюта и бюджет останутся. Копия старого файла сохранится в finance-backup.txt.", "Очистить статистику?")
                @oldF = getFile("finance.txt", nil, false)
                if @oldF {
                    @bak = setName(@oldF, "finance-backup.txt")
                    saveFile("finance-backup.txt", @bak, true)
                }
                @keepLines = matchText('(?m)^(FIN1|[sc][|].*)$', @data)
                @keepText = joinText(@keepLines, "\n")
                @newF = setName(@keepText, "finance.txt")
                saveFile("finance.txt", @newF, true)
                showNotification("Статистика очищена, категории остались", "Финансы", false)
                stop()
            item "Открыть статистику":
                @mode = "stats"
        }
        if @mode != "stats" {
            stop()
        }
    }

    if @mode != "stats" {
        // найти id выбранной категории по названию
        @catId = ""
        for catLine2 in @catLines {
            @g = splitText("{@catLine2}", "|")
            @gId = getListItem(@g, 2)
            @gName = getListItem(@g, 4)
            @gLabel = "{@gName}"
            if @gLabel == @chosenName {
                @catId = "{@gId}"
            }
        }
        if !@catId {
            @catId = "z"
        }

        if @catId == "z" {
            @custom = prompt("На что именно?", "Text", @note)
            @note = "{@custom}"
        }

        if @mode == "menu" {
            @asked = prompt("Сумма: {@chosenName}", "Number")
            @amount = "{@asked}"
        }

        @n1 = replaceText("|", "/", @note)
        @n2 = replaceText("\n", " ", @n1)
        @a1 = replaceText("|", "", @amount)
        @txLine = "{@ts}|{@a1}|{@catId}|{@n2}"
        appendToFile("finance.txt", @txLine)
        showNotification("{@chosenName}: {@a1}", "Записано", false)
        stop()
    }
}

// ---------- открыть статистику ----------
if @mode == "stats" {
    @dataFile = getFile("finance.txt", nil, false)
    @gz = makeArchive(@dataFile, ".gz", "finance")
    @b64 = base64Encode(@gz)
    @enc = urlEncode(@b64)
    @siteUrl = text(site)
    openURL("{@siteUrl}?t={@ts}#z={@enc}")
}
